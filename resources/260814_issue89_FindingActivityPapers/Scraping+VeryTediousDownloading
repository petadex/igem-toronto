def handle_science_direct_bot_check(driver):
    """Scans the page for ScienceDirect anti-bot indicators and clears them."""
    bot_check_indicators = [
        "//*[contains(text(), 'Please confirm you are a human')]",
        "//*[contains(text(), 'Verify you are human')]"
    ]
    
    is_bot_page = False
    for xpath in bot_check_indicators:
        if driver.find_elements(By.XPATH, xpath):
            is_bot_page = True
            break
            
    if is_bot_page:
        print("Bot verification page detected. Attempting bypass...")
        time.sleep(2)
        
        try:
            checkbox = driver.find_element(By.XPATH, "//label[contains(., 'Verify you are human')]//input[@type='checkbox']")
            driver.execute_script("arguments[0].click();", checkbox)
            print("Successfully clicked verification checkbox via HTML.")
            time.sleep(5)
            return
        except Exception:
            print("HTML checkbox selection unavailable or blocked. Trying PyAutoGUI fallback...")
        
        pyautogui.moveTo(684, 357, duration=0.6)
        pyautogui.click()
        print("Triggered PyAutoGUI click at coordinates (684, 357).")
        time.sleep(5)

def navigate_to_page_by_numbers(driver, target_page):
    """Navigates to a specific page number, with protection against infinite pagination loops."""
    if target_page <= 1:
        return True
        
    print(f"Navigating directly to page {target_page} using numbered buttons...")
    last_max_page = 0
    stuck_counter = 0
    
    while True:
        try:
            WebDriverWait(driver, 15).until(
                EC.presence_of_all_elements_located((By.CSS_SELECTOR, "button.page-number"))
            )
            page_buttons = driver.find_elements(By.CSS_SELECTOR, "button.page-number")
            
            available_pages = {}
            for btn in page_buttons:
                text_val = btn.text.strip()
                if text_val.isdigit():
                    available_pages[int(text_val)] = btn
                    
            if not available_pages:
                print("Could not parse page numbers.")
                return False
                
            if target_page in available_pages:
                print(f"Target page {target_page} is visible. Clicking it.")
                driver.execute_script("arguments[0].scrollIntoView({block: 'center'});", available_pages[target_page])
                time.sleep(1)
                available_pages[target_page].click()
                time.sleep(6) 
                return True
            else:
                max_page = max(available_pages.keys())
                
                # STAGNATION DETECTOR
                if max_page == last_max_page:
                    stuck_counter += 1
                    if stuck_counter >= 2:
                        print(f"Warning: Pagination is glitched and stuck at page {max_page}. Cannot reach page {target_page}.")
                        return False
                else:
                    stuck_counter = 0
                    
                last_max_page = max_page
                
                print(f"Target page {target_page} not visible. Clicking highest available page ({max_page}) to shift pagination...")
                driver.execute_script("arguments[0].scrollIntoView({block: 'center'});", available_pages[max_page])
                time.sleep(1)
                available_pages[max_page].click()
                time.sleep(6) 
        except Exception as e:
            print(f"Pagination navigation encountered an error: {e}")
            return False

