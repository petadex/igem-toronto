def _click_articles_filter(driver):
    """Internal helper to execute the physical click on the Articles filter."""
    try:
        articles_btn = driver.find_element(By.CSS_SELECTOR, "button[data-qa='rt_articles']")
        print("Enforcing 'Articles' filter selection...")
        driver.execute_script("arguments[0].scrollIntoView({block: 'center'});", articles_btn)
        time.sleep(1)
        driver.execute_script("arguments[0].click();", articles_btn)
        print("Successfully clicked the 'Articles' filter. Waiting dynamically for items to update...")
        # Dynamic wait for the page to react to the filter click
        try:
            WebDriverWait(driver, 30).until(EC.staleness_of(articles_btn))
        except:
            time.sleep(3)
    except NoSuchElementException:
        print("Alert: Could not locate the 'Articles' filter button.")

def ensure_articles_filter_via_results_count(driver):
    """Checks the total results count. Only clicks the filter if results < 100k or missing."""
    print("Verifying total result count to determine filter state...")
    try:
        results_element = WebDriverWait(driver, 15).until(
            EC.presence_of_element_located((By.CSS_SELECTOR, "span.number-of-results"))
        )
        text_val = results_element.text.strip()
        print(f"Results string found: '{text_val}'")
        
        match = re.search(r"of\s+([\d,]+)\s+result", text_val, re.IGNORECASE)
        if match:
            total_str = match.group(1).replace(",", "")
            total_results = int(total_str)
            print(f"Parsed total results: {total_results}")
            
            if total_results < 100000:
                print(f"Total results ({total_results}) is less than 100k. Filter likely dropped. Clicking 'Articles'...")
                _click_articles_filter(driver)
                return True
            else:
                print(f"Total results ({total_results}) >= 100k. Filter is active. Skipping click to prevent desync.")
                return False
        else:
            print("Could not parse the exact number from the text. Defaulting to click safety.")
            _click_articles_filter(driver)
            return True
            
    except TimeoutException:
        print("Alert: 'number-of-results' element not found (possible 0 results glitch). Defaulting to clicking the filter.")
        _click_articles_filter(driver)
        return True
    except Exception as e:
        print(f"Error checking result count: {e}. Defaulting to clicking filter.")
        _click_articles_filter(driver)
        return True

def verify_url_offset(driver, intended_page):
    """Calculates and checks if the URL offset parameter matches the expected page state."""
    current_url = driver.current_url
    expected_offset = (intended_page - 1) * 50
    
    match = re.search(r"[?&]offset=(\d+)", current_url)
    if match:
        actual_offset = int(match.group(1))
        if actual_offset != expected_offset:
            print(f"Warning: URL offset mismatch! Page {intended_page} expects offset {expected_offset}, but current URL is offset {actual_offset}.")
            return False
        else:
            print(f"URL validation verified: Offset is currently correct ({actual_offset}) for page {intended_page}.")
            return True
    else:
        print("Could not locate an explicit 'offset=' value inside the active URL query parameter string.")
        return False

def handle_science_direct_bot_check(driver):
    """Scans the page for ScienceDirect anti-bot indicators and clears them."""
    bot_check_indicators = [
        "//*[contains(text(), 'Please confirm you are a human')]",
        "//*[contains(text(), 'Verify you are human')]"
    ]
    
    is_bot_page = False
    for xpath in bot_check_indicators:
        if driver.find_elements(By.XPATH, xpath):
            is_bot_page = True
            break
            
    if is_bot_page:
        print("Bot verification page detected. Attempting bypass...")
        time.sleep(2)
        
        try:
            checkbox = driver.find_element(By.XPATH, "//label[contains(., 'Verify you are human')]//input[@type='checkbox']")
            driver.execute_script("arguments[0].click();", checkbox)
            print("Successfully clicked verification checkbox via HTML.")
            time.sleep(5)
            return
        except Exception:
            print("HTML checkbox selection unavailable or blocked. Trying PyAutoGUI fallback...")
        
        pyautogui.moveTo(684, 357, duration=0.6)
        pyautogui.click()
        print("Triggered PyAutoGUI click at coordinates (684, 357).")
        time.sleep(5)

def navigate_to_page_by_numbers(driver, target_page):
    """Navigates to a specific page number with dynamic waits."""
    if target_page <= 1:
        return True
        
    while True: 
        print(f"Navigating directly to page {target_page} using numbered buttons...")
        last_max_page = 0
        stuck_counter = 0
        session_died = False
        
        while True: 
            # Dynamically wait up to 120s for pagination buttons OR error text
            try:
                WebDriverWait(driver, 120).until(
                    lambda d: d.find_elements(By.CSS_SELECTOR, "button.page-number") or 
                              d.find_elements(By.XPATH, "//*[contains(text(), 'No Records Found') or contains(text(), 'No records found')]")
                )
            except TimeoutException:
                print("Timeout waiting for pagination buttons to appear.")
                return False

            no_records = driver.find_elements(By.XPATH, "//*[contains(text(), 'No Records Found') or contains(text(), 'No records found')]")
            if no_records:
                print("Session death detected during navigation. Aborting current pagination path...")
                session_died = True
                break 
            
            try:
                page_buttons = driver.find_elements(By.CSS_SELECTOR, "button.page-number")
                available_pages = {}
                for btn in page_buttons:
                    text_val = btn.text.strip()
                    if text_val.isdigit():
                        available_pages[int(text_val)] = btn
                        
                if not available_pages:
                    print("Could not parse page numbers.")
                    return False
                    
                if target_page in available_pages:
                    print(f"Target page {target_page} is visible. Clicking it.")
                    target_btn = available_pages[target_page]
                    driver.execute_script("arguments[0].scrollIntoView({block: 'center'});", target_btn)
                    time.sleep(1)
                    target_btn.click()
                    
                    # Dynamically wait for the old button to go stale (meaning the page turned)
                    try:
                        WebDriverWait(driver, 15).until(EC.staleness_of(target_btn))
                    except:
                        pass
                        
                    return True 
                else:
                    max_page = max(available_pages.keys())
                    
                    if max_page == last_max_page:
                        stuck_counter += 1
                        if stuck_counter >= 3:
                            print(f"Warning: Pagination is glitched and stuck at page {max_page}. Cannot reach page {target_page}.")
                            return False
                    else:
                        stuck_counter = 0
                        
                    last_max_page = max_page
                    
                    print(f"Target page {target_page} not visible. Clicking highest available page ({max_page}) to shift pagination...")
                    max_btn = available_pages[max_page]
                    driver.execute_script("arguments[0].scrollIntoView({block: 'center'});", max_btn)
                    time.sleep(1)
                    max_btn.click()
                    
                    # Dynamically wait for the old button to go stale before looping
                    try:
                        WebDriverWait(driver, 15).until(EC.staleness_of(max_btn))
                    except:
                        pass
                    
            except Exception as e:
                print(f"Pagination navigation encountered an error: {e}")
                return False
                
        if session_died:
            print("Executing Emergency Search Reload from inside navigation function...")
            try:
                search_btn = driver.find_element(By.CSS_SELECTOR, "button[aria-label='Submit search']")
                driver.execute_script("arguments[0].scrollIntoView({block: 'center'});", search_btn)
                time.sleep(1)
                search_btn.click()
                # Dynamic wait for old search button to detach
                try:
                    WebDriverWait(driver, 15).until(EC.staleness_of(search_btn))
                except:
                    time.sleep(3)
                
                ensure_articles_filter_via_results_count(driver)
            except Exception as e:
                print(f"Emergency reload failed during navigation: {e}")
                return False

