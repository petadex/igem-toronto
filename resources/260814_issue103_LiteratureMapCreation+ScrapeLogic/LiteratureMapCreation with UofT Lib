def set_cdp_download_directory(driver, target_dir):
    if not os.path.exists(target_dir):
        os.makedirs(target_dir)
    driver.execute_cdp_cmd("Page.setDownloadBehavior", {
        "behavior": "allow",
        "downloadPath": os.path.abspath(target_dir)
    })
    print(f"CDP: Download location redirected to: {target_dir}")

def sanitize_doi(doi):
    return doi.replace("/", "_").replace(":", "-")

def get_dois_from_jsons(folder_path):
    dois = []
    json_files = glob.glob(os.path.join(folder_path, "*.json"))
    for file_path in json_files:
        try:
            with open(file_path, "r", encoding="utf-8") as f:
                data = json.load(f)
                if isinstance(data, dict) and data.get("doi"):
                    dois.append(data["doi"])
        except Exception as e:
            print(f"Error parsing file mapping {file_path}: {e}")
    return dois

def get_current_files(directory):
    if not os.path.exists(directory):
        return set()
    return set(os.listdir(directory))

def wait_for_new_download(directory, before_files, timeout=30):
    print(f"Polling directory for new file up to {timeout} seconds...")
    start_time = time.time()
    while time.time() - start_time < timeout:
        current_files = get_current_files(directory)
        new_files = current_files - before_files
        valid_files = [f for f in new_files if not f.endswith('.crdownload') and not f.endswith('.tmp')]
        if valid_files:
            print(f"Success! Download detected: {valid_files[0]}")
            return True
        time.sleep(1)
    print("Download polling timed out. Considered a failure.")
    return False

def verify_url_offset(driver, intended_page):
    current_url = driver.current_url
    expected_offset = (intended_page - 1) * 50
    match = re.search(r"[?&]offset=(\d+)", current_url)
    if match:
        actual_offset = int(match.group(1))
        if actual_offset != expected_offset:
            print(f"Warning: URL offset mismatch! Page {intended_page} expects offset {expected_offset}, but current URL is offset {actual_offset}.")
            return False
        return True
    return False

def navigate_to_page_by_numbers(driver, target_page):
    if target_page <= 1:
        return True
        
    while True: 
        print(f"Navigating directly to page {target_page} using numbered buttons...")
        last_max_page = 0
        stuck_counter = 0
        
        while True: 
            try:
                WebDriverWait(driver, 60).until(
                    lambda d: d.find_elements(By.CSS_SELECTOR, "button.page-number") or 
                              d.find_elements(By.XPATH, "//*[contains(text(), 'No Records Found')]")
                )
            except TimeoutException:
                print("Timeout waiting for pagination buttons to appear.")
                return False

            if driver.find_elements(By.XPATH, "//*[contains(text(), 'No Records Found')]"):
                print("Session death detected during navigation skip.")
                return False 
            
            try:
                page_buttons = driver.find_elements(By.CSS_SELECTOR, "button.page-number")
                available_pages = {}
                for btn in page_buttons:
                    text_val = btn.text.strip()
                    if text_val.isdigit():
                        available_pages[int(text_val)] = btn
                        
                if not available_pages:
                    return False
                    
                if target_page in available_pages:
                    target_btn = available_pages[target_page]
                    driver.execute_script("arguments[0].scrollIntoView({block: 'center'});", target_btn)
                    time.sleep(1)
                    target_btn.click()
                    try:
                        WebDriverWait(driver, 15).until(EC.staleness_of(target_btn))
                    except:
                        pass
                    return True 
                else:
                    max_page = max(available_pages.keys())
                    if max_page == last_max_page:
                        stuck_counter += 1
                        if stuck_counter >= 3:
                            return False
                    else:
                        stuck_counter = 0
                        
                    last_max_page = max_page
                    max_btn = available_pages[max_page]
                    driver.execute_script("arguments[0].scrollIntoView({block: 'center'});", max_btn)
                    time.sleep(1)
                    max_btn.click()
                    try:
                        WebDriverWait(driver, 15).until(EC.staleness_of(max_btn))
                    except:
                        pass
            except Exception as e:
                print(f"Pagination navigation encountered an error: {e}")
                return False

def execute_citation_recovery(driver, doi, citation_selector, target_page):
    print(f"Executing Deep Recovery for DOI {doi} -> Citation Layer -> Page {target_page}")
    driver.get("https://librarysearch.library.utoronto.ca")
    time.sleep(3)
    
    try:
        search_input = WebDriverWait(driver, 15).until(EC.presence_of_element_located((By.CSS_SELECTOR, SEARCH_INPUT_SELECTOR)))
        search_input.clear()
        search_input.send_keys(doi)
        driver.find_element(By.CSS_SELECTOR, SEARCH_BUTTON_SELECTOR).click()
        
        WebDriverWait(driver, 20).until(EC.presence_of_element_located((By.CSS_SELECTOR, citation_selector)))
        cit_btn = driver.find_element(By.CSS_SELECTOR, citation_selector)
        driver.execute_script("arguments[0].scrollIntoView({block: 'center'});", cit_btn)
        time.sleep(1)
        cit_btn.click()
        
        WebDriverWait(driver, 20).until(
            lambda d: d.find_elements(By.CSS_SELECTOR, BUTTON_SELECTOR) or 
                      d.find_elements(By.XPATH, "//*[contains(text(), 'No Records Found')]")
        )
        
        if target_page > 1:
            success = navigate_to_page_by_numbers(driver, target_page)
            return success
        return True
    except Exception as e:
        print(f"Deep recovery completely failed: {e}")
        return False

