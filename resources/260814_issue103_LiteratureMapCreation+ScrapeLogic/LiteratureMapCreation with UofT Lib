def process_citation_layer(driver, main_window, download_dir, doi, citation_selector):
    current_page = 1
    while True:
        print(f"\n--- Citation Page {current_page} ---")
        
        try:
            WebDriverWait(driver, 20).until(
                lambda d: d.find_elements(By.CSS_SELECTOR, BUTTON_SELECTOR) or 
                          d.find_elements(By.XPATH, "//*[contains(text(), 'No Records Found')]")
            )
        except TimeoutException:
            pass

        if driver.find_elements(By.XPATH, "//*[contains(text(), 'No Records Found')]"):
            print("Glitch detected! Initiating recovery sequence...")
            recovered = execute_citation_recovery(driver, doi, citation_selector, current_page)
            if not recovered:
                print("Recovery failed. Aborting this citation thread.")
                break

        download_visible_results(driver, main_window, download_dir)

        try:
            next_button = driver.find_element(By.CSS_SELECTOR, NEXT_PAGE_SELECTOR)
            if next_button.get_attribute("disabled") or "disabled" in next_button.get_attribute("class"):
                print("Next button disabled. Reached end of citations.")
                break

            driver.execute_script("arguments[0].scrollIntoView({block: 'center'});", next_button)
            time.sleep(1)
            
            old_elements = driver.find_elements(By.CSS_SELECTOR, BUTTON_SELECTOR)
            old_ref = old_elements[0] if old_elements else None
            
            next_button.click()
            current_page += 1
            print("Clicked Next Page. Loading...")
            
            if old_ref:
                try:
                    WebDriverWait(driver, 15).until(EC.staleness_of(old_ref))
                except:
                    pass
            verify_url_offset(driver, current_page)
            
        except NoSuchElementException:
            print("No 'Next Page' button found. Reached end of citations.")
            break

