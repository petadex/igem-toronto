def set_cdp_download_directory(driver, target_dir):
    if not os.path.exists(target_dir):
        os.makedirs(target_dir)
    driver.execute_cdp_cmd("Page.setDownloadBehavior", {
        "behavior": "allow",
        "downloadPath": os.path.abspath(target_dir)
    })

def sanitize_filename(name):
    if not name:
        return "Unknown"
    return re.sub(r'[\\/*?:"<>|]', "_", name)[:100]

def parse_bibtex(bibtex_str):
    data = {"title": "N/A", "doi": "N/A", "author": "N/A", "journal": "N/A", "year": "N/A"}
    
    title_match = re.search(r'title\s*=\s*[{"](.*?)[}"]', bibtex_str, re.IGNORECASE | re.DOTALL)
    doi_match = re.search(r'doi\s*=\s*[{"](.*?)[}"]', bibtex_str, re.IGNORECASE)
    author_match = re.search(r'author\s*=\s*[{"](.*?)[}"]', bibtex_str, re.IGNORECASE | re.DOTALL)
    journal_match = re.search(r'journal\s*=\s*[{"](.*?)[}"]', bibtex_str, re.IGNORECASE)
    year_match = re.search(r'year\s*=\s*[{"](.*?)[}"]', bibtex_str, re.IGNORECASE)
    
    if title_match: data["title"] = title_match.group(1).strip()
    if doi_match: data["doi"] = doi_match.group(1).strip()
    if author_match: data["author"] = author_match.group(1).replace("\n", " ").strip()
    if journal_match: data["journal"] = journal_match.group(1).strip()
    if year_match: data["year"] = year_match.group(1).strip()
        
    return data

def safe_scroll_into_view(driver, element):
    """
    Scrolls just enough to make the element visible 
    without forcing it to the center or end.
    """
    driver.execute_script("""
        var element = arguments[0];
        var rect = element.getBoundingClientRect();
        // Check if the element is already in view
        if (rect.top >= 0 && rect.bottom <= (window.innerHeight || document.documentElement.clientHeight)) {
            return; // Already visible, no need to scroll
        }
        // Otherwise, scroll the parent container just enough
        element.scrollIntoView({behavior: 'smooth', block: 'nearest', inline: 'nearest'});
    """, element)

def get_current_files(directory):
    if not os.path.exists(directory): return set()
    return set(os.listdir(directory))

def wait_for_new_download(directory, before_files, timeout=30):
    start_time = time.time()
    while time.time() - start_time < timeout:
        current_files = get_current_files(directory)
        new_files = current_files - before_files
        valid_files = [f for f in new_files if not f.endswith('.crdownload') and not f.endswith('.tmp')]
        if valid_files: return valid_files[0]
        time.sleep(1)
    return None

def safe_js_click(driver, element):
    """
    Force-clicks an element using JavaScript.
    'block: end' ensures the element is at the bottom of the container,
    preventing it from being pushed off-screen by over-scrolling.
    """
    # block: 'end' aligns the element to the bottom of the visible area
    driver.execute_script("arguments[0].scrollIntoView({block: 'end', inline: 'nearest'});", element)
    time.sleep(0.5)
    driver.execute_script("arguments[0].click();", element)

def fetch_bibtex_data(driver):
    bibtex_str = ""
    print("[DEBUG] Initiating BibTeX fetch...")
    
    for attempt in range(3):
        try:
            print(f"[DEBUG] --- Attempt {attempt + 1} of 3 ---")
            #time.sleep(1)
            print("[DEBUG] Attempting to click 3-dots...")
            three_dots = WebDriverWait(driver, 10).until(EC.element_to_be_clickable((By.XPATH, THREE_DOTS_XPATH))).click()
            
            #time.sleep(0.5)
            
            print("[DEBUG] Attempting to click Cite...")
            cite_opt = WebDriverWait(driver, 10).until(EC.element_to_be_clickable((By.XPATH, CITE_MENU_OPT_XPATH)))
            safe_js_click(driver, cite_opt)
            #time.sleep(1.5)
            
            print("[DEBUG] Checking style box...")
            style_box = WebDriverWait(driver, 5).until(EC.presence_of_element_located((By.XPATH, FORMAT_COMBOBOX_XPATH)))
            if not "BibTeX" in style_box.text:
                time.sleep(0.5)
                style_box = WebDriverWait(driver, 5).until(EC.presence_of_element_located((By.XPATH, FORMAT_COMBOBOX_XPATH)))
                if not "BibTeX" in style_box.text:
                    print("\n[!] nonBibTeX FORMAT DETECTED [!]")
                    input("Please manually change the dropdown to BibTeX, check 'Always use this style', then press Enter here to resume...")
            
            print("[DEBUG] Locating BibTeX container...")
            bibtex_container = WebDriverWait(driver, 10).until(EC.presence_of_element_located((By.XPATH, BIBTEX_CONTAINER_XPATH)))
            
            # Verbose Capture Attempts
            print("[DEBUG] Attempting textContent capture...")
            bibtex_str = driver.execute_script("return arguments[0].textContent;", bibtex_container)
            
            if not bibtex_str or bibtex_str.strip() == "":
                print("[DEBUG] textContent was empty. Trying innerHTML as Plan B...")
                # Plan B: Get raw HTML and regex-strip the tags manually
                raw_html = driver.execute_script("return arguments[0].innerHTML;", bibtex_container)
                bibtex_str = re.sub('<[^<]+?>', '', raw_html)
                
            print(f"[DEBUG] Raw text captured length: {len(bibtex_str)}")
            print(f"[DEBUG] Printing captured text: {bibtex_str}")
            
            print("[DEBUG] Clicking Done...")
            done_btn = WebDriverWait(driver, 10).until(EC.element_to_be_clickable((By.XPATH, DONE_BTN_XPATH)))
            safe_js_click(driver, done_btn)
            #time.sleep(1)
            
            break # Success! Exit the retry loop.
            
        except Exception as e:
            print(f"[ERROR] fetch_bibtex_data attempt {attempt + 1} failed: {type(e).__name__} - {e}")
            time.sleep(2) # Buffer before retry
            if attempt == 2:
                # On final failure, return empty to let the main script gracefully log it as N/A
                return parse_bibtex("")
                
    return parse_bibtex(bibtex_str)
def check_button_count(driver, xpath_selector):
    try:
        btn = driver.find_element(By.XPATH, xpath_selector)
        text = btn.text 
        match = re.search(r'\d+', text)
        if match: return int(match.group()), btn
    except NoSuchElementException:
        pass
    return 0, None

