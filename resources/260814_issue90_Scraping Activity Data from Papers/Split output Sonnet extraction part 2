# HELPER FUNCTIONS

def filter_references_from_json(obj):
    if isinstance(obj, list):
        filtered_list = []
        for item in obj:
            if isinstance(item, dict):
                sec = str(item.get("section", "")).lower()
                if "reference" in sec or "bibliography" in sec:
                    continue
            filtered_item = filter_references_from_json(item)
            if filtered_item is not None:
                filtered_list.append(filtered_item)
        return filtered_list
    elif isinstance(obj, dict):
        sec = str(obj.get("section", "")).lower()
        if "reference" in sec or "bibliography" in sec:
            return None
        
        new_dict = {}
        for k, v in obj.items():
            val = filter_references_from_json(v)
            if val is not None:
                new_dict[k] = val
        return new_dict
    return obj

def get_paper_text(record_id, input_dir):
    cleaned_id = ''.join(e for e in record_id if e.isalnum()).lower()
    
    for filename in os.listdir(input_dir):
        file_base = os.path.splitext(filename)[0]
        cleaned_file_base = ''.join(e for e in file_base if e.isalnum()).lower()
        
        if cleaned_id in cleaned_file_base or cleaned_file_base in cleaned_id:
            full_path = os.path.join(input_dir, filename)
            try:
                with open(full_path, 'r', encoding='utf-8', errors='ignore') as f:
                    file_content = f.read()
                
                try:
                    paper_data = json.loads(file_content)
                    filtered_data = filter_references_from_json(paper_data)
                    return json.dumps(filtered_data)
                except json.JSONDecodeError:
                    lower_content = file_content.lower()
                    ref_idx = lower_content.rfind("\nreferences\n")
                    if ref_idx == -1:
                        ref_idx = lower_content.rfind("\nbibliography\n")
                    
                    if ref_idx != -1 and ref_idx > (len(file_content) / 2):
                        return file_content[:ref_idx]
                        
                    return file_content
                    
            except Exception as e:
                print(f"Warning: Failed to read file {full_path}: {e}")
                return ""
    return ""

def estimate_and_verify_cost(total_chunks, estimated_input_tokens, estimated_output_tokens):
    input_cost = (estimated_input_tokens / 1000000) * ESTIMATED_INPUT_COST_PER_1M
    output_cost = (estimated_output_tokens / 1000000) * ESTIMATED_OUTPUT_COST_PER_1M
    total_cost = input_cost + output_cost
    
    print("\n" + "="*60)
    print("PRE-RUN COST ESTIMATE (ALL MAPPED PAPERS)")
    print("="*60)
    print(f"Total Target Chunks to Process: {total_chunks}")
    print(f"Estimated Total Input Tokens:   {estimated_input_tokens:,}")
    print(f"Estimated Total Output Tokens:  {estimated_output_tokens:,}")
    print("*" * 60)
    print(f"Estimated Input Cost:           ${input_cost:.2f}")
    print(f"Estimated Output Cost:          ${output_cost:.2f}")
    print(f"ESTIMATED TOTAL AWS COST:       ${total_cost:.2f}")
    print(f"MAX ALLOWED BUDGET:             ${MAX_BUDGET_USD:.2f}")
    print("="*60 + "\n")
    
    if total_cost > MAX_BUDGET_USD:
        print(f"ERROR: Estimated cost (${total_cost:.2f}) exceeds max budget (${MAX_BUDGET_USD:.2f}). Aborting.")
        sys.exit(1)
        
    response = input("Do you want to proceed with generating the local file? (y/n): ")
    if response.lower() != 'y':
        print("Aborting run.")
        sys.exit(0)


