                    stats["missing_output"] += 1
                    continue
                    
                content_text = ""
                
                if "message" in model_out and "content" in model_out["message"]:
                    for block in model_out["message"]["content"]:
                        if block.get("type") == "text":
                            content_text += block.get("text", "")
                elif "content" in model_out and isinstance(model_out["content"], list):
                    for block in model_out["content"]:
                        if block.get("type") == "text":
                            content_text += block.get("text", "")
                            
                elif "invokeModelResult" in model_out:
                    body_data = model_out["invokeModelResult"].get("body", "")
                    if isinstance(body_data, str) and not body_data.strip().startswith('{'):
                        try:
                            body_data = base64.b64decode(body_data).decode('utf-8')
                        except Exception:
                            pass
                    try:
                        body_json = json.loads(body_data) if isinstance(body_data, str) else body_data
                        if isinstance(body_json, dict) and "content" in body_json:
                            content_text = body_json["content"][0].get("text", "")
                        else:
                            content_text = str(body_json)
                    except Exception:
                        pass

                if not content_text:
                    stats["no_text"] += 1
                    continue
                
                start_idx = content_text.find('{')
                end_idx = content_text.rfind('}')
                
                if start_idx == -1 or end_idx == -1 or end_idx < start_idx:
                    stats["no_json"] += 1
                    continue
                    
                json_str = content_text[start_idx:end_idx+1]
                    
                try:
                    pass1_data = json.loads(json_str)
                except Exception as e:
                    stats["malformed_json"] += 1
                    continue
                
                proteins = pass1_data.get("proteins", [])
                plasmids = pass1_data.get("plasmids", [])
                experiments = pass1_data.get("experiments", [])

