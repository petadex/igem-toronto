def get_aws_session():
    """Initializes and returns an authenticated boto3 session."""
    return boto3.Session(
        aws_access_key_id=AWS_ACCESS_KEY,
        aws_secret_access_key=AWS_SECRET_KEY,
        aws_session_token=AWS_SESSION_TOKEN,
        region_name=REGION_NAME
    )

def build_paper_cache(text_dir):
    """
    Indexes classified paper JSONs and concatenates section texts 
    from the 'content' list into full paper strings.
    """
    cache = {}
    json_files = glob.glob(os.path.join(text_dir, "*.json"))
    print(f"Indexing {len(json_files)} classified paper JSONs from text directory...")
    
    for file_path in json_files:
        filename = os.path.basename(file_path).replace(".json", "")
        try:
            with open(file_path, 'r', encoding='utf-8', errors='ignore') as f:
                data = json.load(f)
                
                content_blocks = data.get("content", [])
                text_parts = []
                for block in content_blocks:
                    if isinstance(block, dict) and "text" in block:
                        text_parts.append(block["text"])
                
                full_text = " ".join(text_parts).strip()
                
                if full_text:
                    cache[filename] = full_text
                    doc_id = data.get("document_id")
                    if doc_id:
                        cache[doc_id] = full_text
        except Exception as e:
            print(f"Warning: Could not read classified text file {file_path}: {e}")
            
    print(f"Successfully loaded text for {len(cache)} paper references.")
    return cache

def load_paper_text(paper_id, paper_cache):
    """Looks up full paper text from the pre-indexed cache."""
    if paper_id in paper_cache:
        return paper_cache[paper_id]
        
    sanitized_id = paper_id.replace("_", "-")
    if sanitized_id in paper_cache:
        return paper_cache[sanitized_id]
        
    return ""

def load_papers_from_jsons(json_directory):
    """Groups all relational entities by their parent paper and tracks dropped files."""
    papers_data = []
    dropped_no_enzyme = 0
    dropped_empty_vars = 0
    
    json_files = glob.glob(os.path.join(json_directory, "*.json"))
    print(f"Found {len(json_files)} extracted JSON files to process.")
    
    for file_path in json_files:
        try:
            with open(file_path, 'r', encoding='utf-8') as f:
                data = json.load(f)
                
                if data.get("Has_Plastic_Degrading_Enzyme") == "No":
                    dropped_no_enzyme += 1
                    continue

                paper_id = os.path.basename(file_path).replace(".json", "")
                
                # Group all relevant items into a single paper payload
                paper_payload = {
                    "proteins": data.get("proteins", []),
                    "assays_main": data.get("assays_main", []),
                    "assay_variables": data.get("assay_variables", []),
                    "activity": data.get("activity", []),
                    "experiments": data.get("experiments", [])
                }

                if any(len(v) > 0 for v in paper_payload.values()):
                    papers_data.append({
                        "paper_id": paper_id,
                        "grouped_relations": paper_payload
                    })
                else:
                    dropped_empty_vars += 1

        except Exception as e:
            print(f"Error reading {file_path}: {e}")
            
    return papers_data, dropped_no_enzyme, dropped_empty_vars

def estimate_tokens(text):
    words = len(str(text).split())
    return math.ceil(words * 1.3)

def generate_verification_prompts(papers_data, paper_cache):
    requests = []
    total_input_tokens = 0
    estimated_output_tokens = 0
    dropped_missing_text = 0
    
    system_prompt = (
        "You are a scientific data verification assistant. "
        "Review the provided JSON map of extracted experimental variables against the full text of the paper. "
        "Your task is to verify relational integrity. Confirm that the listed proteins, assay conditions, and activities "
        "actually belong to the same experiments and are correctly linked to one another based on the text. "
        "List any incorrect linkages or mismatched groupings."
    )
    system_tokens = estimate_tokens(system_prompt)

    for paper in papers_data:
        paper_id = paper["paper_id"]
        full_text = load_paper_text(paper_id, paper_cache)
        grouped_relations = paper["grouped_relations"]
        
        # Skip if we couldn't find the text
        if not full_text:
            dropped_missing_text += 1
            continue
            
        prompt_text = (
            f"Full Paper Text:\n\"{full_text}\"\n\n"
            f"Extracted Relationships:\n{json.dumps(grouped_relations, indent=2)}\n\n"
            "Verify if these entities are accurately linked to the correct experiments."
        )
        
        prompt_tokens = estimate_tokens(prompt_text)
        
        record = {
            "recordId": f"{paper_id}_relational_check",
            "modelInput": {
                "anthropic_version": "bedrock-2023-05-31",
                "max_tokens": 500,
                "system": system_prompt,
                "messages": [
                    {"role": "user", "content": prompt_text}
                ]
            }
        }
        requests.append(record)
        
        total_input_tokens += (system_tokens + prompt_tokens)
        # Expected output token length for summarizing incorrect linkages per paper
        estimated_output_tokens += 150

    return requests, total_input_tokens, estimated_output_tokens, dropped_missing_text

def calculate_budget_and_prompt(input_tokens, output_tokens, num_instances):
    input_cost = (input_tokens / 1_000_000) * BATCH_INPUT_COST
    output_cost = (output_tokens / 1_000_000) * BATCH_OUTPUT_COST
    total_cost = input_cost + output_cost

    print("\n" + "="*40)
    print("BATCH JOB BUDGET ESTIMATE")
    print("="*40)
    print(f"Total Paper-Level Records: {num_instances:,}")
    print(f"Estimated Input Tokens: {input_tokens:,} (${input_cost:.2f})")
    print(f"Estimated Output Tokens: {output_tokens:,} (${output_cost:.2f})")
    print(f"TOTAL ESTIMATED BATCH COST: ${total_cost:.2f}")
    
    if total_cost > MAX_BUDGET_USD:
        print(f"\n[WARNING] Estimated cost (${total_cost:.2f}) exceeds maximum budget limit of ${MAX_BUDGET_USD:.2f}!")
    print("="*40 + "\n")

    user_input = input("Do you want to proceed with uploading and job submission? (y/n): ")
    return user_input.strip().lower() == 'y'

def submit_batch_job(requests, job_name):
    session = get_aws_session()
    s3 = session.client('s3')
    bedrock = session.client('bedrock')
    
    file_name = f"{job_name}.jsonl"
    with open(file_name, 'w', encoding='utf-8') as f:
        for req in requests:
            f.write(json.dumps(req) + '\n')
            
    s3_key = f"{INPUT_PREFIX}{file_name}"
    print(f"Uploading {file_name} to s3://{BUCKET_NAME}/{s3_key}...")
    s3.upload_file(file_name, BUCKET_NAME, s3_key)
    
    print(f"Submitting job to AWS Bedrock using model {MODEL_ID}...")
    response = bedrock.create_model_invocation_job(
        jobName=job_name,
        roleArn=ROLE_ARN,
        modelId=MODEL_ID, 
        inputDataConfig={
            's3InputDataConfig': {
                's3Uri': f"s3://{BUCKET_NAME}/{s3_key}"
            }
        },
        outputDataConfig={
            's3OutputDataConfig': {
                's3Uri': f"s3://{BUCKET_NAME}/{OUTPUT_PREFIX}"
            }
        }
    )
    
    job_arn = response.get('jobArn')
    print(f"Job successfully submitted! Job ARN:\n{job_arn}")

