def self_tests():
    assert merge_intervals([(5,8),(1,3),(3,4),(7,9)]) == [(1,9)]
    assert complement(10, [(1,2),(5,8)]) == [(3,4),(9,10)]
    assert complement(10, []) == [(1,10)]
    assert complement(10, [(1,10)]) == []
    assert complement(10, [(1,9)], 2) == []
    seqs = {'orf_with_underscores': 'A'*10, 'no_hit': 'C'*10}
    result, rows = extract_fragments(seqs, {'orf_with_underscores': [(3,8)]}, 'both_remaining', 2)
    assert result['orf_with_underscores_both_remaining_1_2'] == 'AA'
    assert result['orf_with_underscores_both_remaining_9_10'] == 'AA'
    assert result['no_hit_both_remaining_1_10'] == 'C'*10
    # Independent per-residue oracle for complement(union) == intersection(complements).
    import random
    rng = random.Random(59)
    for _ in range(100):
        a = [tuple(sorted(rng.sample(range(1,41),2))) for _ in range(4)]
        b = [tuple(sorted(rng.sample(range(1,41),2))) for _ in range(4)]
        expected = {i for i in range(1,41) if not any(s<=i<=e for s,e in a+b)}
        actual = {i for s,e in complement(40,a+b) for i in range(s,e+1)}
        assert actual == expected
    hits = [{'protein_id':'p','start':5,'end':10,'raw':'touch'},
            {'protein_id':'p','start':11,'end':20,'raw':'separate'}]
    audit, kept = accessory_classification(hits, [{'protein_id':'p','start':1,'end':5,'hmm':'h'}])
    assert kept == ['separate'] and audit[0]['category'] == 'overlaps_HMMER'
    with tempfile.TemporaryDirectory() as d:
        p = Path(d)/'x.fa'
        p.write_text('>a\nAA\n>a\nCC\n')
        try:
            read_fasta(p)
        except ValueError:
            pass
        else:
            raise AssertionError('Duplicate FASTA ID was accepted')
        p.write_text('p - 100 hmm - 20 1e-9 10 0 1 1 1e-9 1e-9 10 0 1 20 3 22 2 24 0.9\n')
        assert parse_hmm(p)[0]['start'] == 3
        assert parse_hmm(p,'envelope')[0]['end'] == 24
    print('PASS: interval, overlap, FASTA, HMM parser checks')

