AWS_EXECUTABLE = str(Path(sys.executable).parent/'aws')
if not Path(AWS_EXECUTABLE).is_file():
    AWS_EXECUTABLE = 'aws'

def aws_cp(src,dst,recursive=False,public=False):
    cmd=[AWS_EXECUTABLE,'s3','cp',str(src),str(dst)]
    if recursive: cmd.append('--recursive')
    if public: cmd.append('--no-sign-request')
    return cmd

def execute_transfer(cmd):
    started=datetime.now(timezone.utc).isoformat()
    try:
        result=subprocess.run(cmd,check=False)
        returncode=result.returncode
        error=None
    except OSError as exc:
        returncode=-1
        error=str(exc)
    entry={'command':shlex.join(cmd),'started_at_utc':started,
           'completed_at_utc':datetime.now(timezone.utc).isoformat(),
           'returncode':returncode,'error':error}
    with (SCRIPTS_DIR/'s3_access_log.jsonl').open('a') as handle:
        handle.write(json.dumps(entry)+'\n')
    if returncode:
        raise RuntimeError('S3 command failed; see s3_access_log.jsonl')

fetch_commands=[aws_cp(S3_PREFIX+'inputs/'+p.name,p,public=S3_PUBLIC_READ)
