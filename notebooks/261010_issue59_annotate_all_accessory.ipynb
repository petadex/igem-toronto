### Parallel per-protein processing

# A small importable worker module makes process spawning work inside Jupyter.
# It is generated automatically; no separate script needs to be downloaded.
import importlib
import multiprocessing as mp
from concurrent.futures import ProcessPoolExecutor
from collections import deque

WORKER_SOURCE = "\ndef process_batch(tasks):\n    results = []\n    for pid, seq, ips, hmms in tasks:\n        annotations = []\n        for index, start, end in ips:\n            names = sorted({name for a,b,name in hmms if start <= b and end >= a})\n            annotations.append((index, {'category':'overlaps_HMMER' if names else 'accessory_candidate',\n                                        'overlap_hmms':';'.join(names)}))\n        intervals = sorted([(a,b) for _,a,b in ips]+[(a,b) for a,b,_ in hmms])\n        merged = []\n        for start,end in intervals:\n            if merged and start <= merged[-1][1]+1:\n                merged[-1] = (merged[-1][0],max(end,merged[-1][1]))\n            else:\n                merged.append((start,end))\n        gaps = []\n        cursor = 1\n        for start,end in merged:\n            if cursor < start:\n                gaps.append((cursor,start-1))\n            cursor = end+1\n        if cursor <= len(seq):\n            gaps.append((cursor,len(seq)))\n        records,rows = {},[]\n        for start,end in gaps:\n            name = f'{pid}_unannotated_{start}_{end}'\n            records[name] = seq[start-1:end]\n            rows.append({'candidate_id':name,'protein_id':pid,'start':start,'end':end,'length':end-start+1})\n        covered = sum(b-a+1 for a,b in merged)\n        summary = {'protein_id':pid,'length':len(seq),'interpro_hits':len(ips),'hmm_hits':len(hmms),\n                   'annotated_residues':covered,'unannotated_residues':len(seq)-covered,'unannotated_fragments':len(gaps)}\n        results.append((annotations,records,rows,summary))\n    return results\n"

def available_cpus():
    if hasattr(os,'sched_getaffinity'):
        return max(1,len(os.sched_getaffinity(0)))
    process_count = getattr(os,'process_cpu_count',lambda:None)()
    return max(1,process_count or os.cpu_count() or 1)

def parallel_protein_analysis(sequences, ips_hits, hmm_hits, workers=None, batch_size=128):
    if workers is not None and (type(workers) is not int or workers < 1):
        raise ValueError('CPU_WORKERS must be None or a positive integer')
    if type(batch_size) is not int or batch_size < 1:
        raise ValueError('PROTEINS_PER_BATCH must be a positive integer')
    requested = available_cpus() if workers is None else workers
    # At least one protein per batch; make enough batches to occupy available cores.
    size = min(batch_size,max(1,(len(sequences)+requested-1)//requested))
    count = (len(sequences)+size-1)//size
    active = min(requested,max(1,count))
    print(f'Processing {len(sequences)} proteins with {active} CPU workers; batch size {size}.')
    ips_by_id, hmm_by_id = defaultdict(list),defaultdict(list)
    for i,h in enumerate(ips_hits):
        ips_by_id[h['protein_id']].append((i,h['start'],h['end']))
    for h in hmm_hits:
        hmm_by_id[h['protein_id']].append((h['start'],h['end'],h['hmm']))
    def batches():
        batch = []
        for pid,seq in sequences.items():
            batch.append((pid,seq,ips_by_id.get(pid,[]),hmm_by_id.get(pid,[])))
            if len(batch)==size:
                yield batch
                batch=[]
        if batch:
            yield batch
    audit = [None]*len(ips_hits)
    gaps,rows,summaries = {},[],[]
    def collect(batch_result):
        for annotations,records,regions,summary in batch_result:
            for index,annotation in annotations:
                audit[index]=annotation
            gaps.update(records)
            rows.extend(regions)
            summaries.append(summary)
    # Limit in-flight batches to keep process queues from copying the whole dataset.
    with tempfile.TemporaryDirectory(prefix='petadex_workers_') as directory:
        module_name = 'petadex_worker_'+uuid.uuid4().hex
        Path(directory,f'{module_name}.py').write_text(WORKER_SOURCE)
        sys.path.insert(0,directory)
        try:
            importlib.invalidate_caches()
            module = importlib.import_module(module_name)
            if active==1:
                for batch in batches():
                    collect(module.process_batch(batch))
            else:
                with ProcessPoolExecutor(max_workers=active,mp_context=mp.get_context('spawn')) as pool:
                    queue, iterator = deque(),iter(batches())
                    for _ in range(2*active):
                        batch=next(iterator,None)
                        if batch is None:
                            break
                        queue.append(pool.submit(module.process_batch,batch))
                    done=0
                    while queue:
                        collect(queue.popleft().result())
                        done+=1
                        if done % max(1,count//10)==0 or done==count:
                            print(f'Completed {done}/{count} batches')
                        batch=next(iterator,None)
                        if batch is not None:
                            queue.append(pool.submit(module.process_batch,batch))
        finally:
            sys.path.remove(directory)
            sys.modules.pop(module_name,None)
    if any(row is None for row in audit):
        raise RuntimeError('Incomplete overlap results')
    settings={'workers_requested':requested,'workers_used':active,'batch_size':size,'start_method':'spawn'}
    return audit,gaps,rows,summaries,settings

ips_audit,gaps,gap_rows,protein_rows,parallel_settings = parallel_protein_analysis(
    sequences,ips_hits,hmm_hits,CPU_WORKERS,PROTEINS_PER_BATCH)
manifest['parallel_processing']=parallel_settings
atomic_text(run_path/'run_manifest.json',json.dumps(manifest,indent=2))

atomic_text(SCRIPTS_DIR/'protein_worker.py',WORKER_SOURCE)

