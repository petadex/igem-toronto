    aws_cp(PROJECT_ROOT/'requirements.txt',S3_PREFIX+'requirements.txt'),
    aws_cp(SCRIPTS_DIR,S3_PREFIX+'scripts/',recursive=True),
]
atomic_text(SCRIPTS_DIR/'upload_archive.sh','#!/usr/bin/env bash\nset -euo pipefail\n'+'\n'.join(shlex.join(c) for c in upload_commands)+'\n')
