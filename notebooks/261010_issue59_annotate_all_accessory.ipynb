import csv, json, math, hashlib, os, sys, uuid, tempfile
from collections import defaultdict
from datetime import datetime, timezone

def read_fasta(path):
    records = {}
    name, chunks = None, []
    def finish():
        if name is None:
            return
        sequence = ''.join(chunks).upper()
        if not sequence:
            raise ValueError(f'{path}: empty sequence for {name}')
        if name in records:
            raise ValueError(f'{path}: duplicate FASTA ID {name}')
        records[name] = sequence
    with open(path) as handle:
        for line_number, line in enumerate(handle, 1):
            line = line.strip()
            if not line:
                continue
            if line.startswith('>'):
                finish()
                tokens = line[1:].split()
                if not tokens:
                    raise ValueError(f'{path}:{line_number}: empty header')
                name, chunks = tokens[0], []
            else:
                if name is None or any(c.isspace() for c in line):
                    raise ValueError(f'{path}:{line_number}: malformed FASTA')
                chunks.append(line)
    finish()
    return records

def atomic_text(path, text):
    path = Path(path)
    temp = path.with_name(path.name + '.partial')
    temp.write_text(text, encoding='utf-8')
    temp.replace(path)

def write_fasta(path, records):
    atomic_text(path, ''.join(f'>{name}\n{seq}\n' for name, seq in records.items()))

def write_table(path, rows, columns):
    path = Path(path)
    temp = path.with_name(path.name + '.partial')
    with temp.open('w', newline='', encoding='utf-8') as handle:
        writer = csv.DictWriter(handle, fieldnames=columns, delimiter='\t', extrasaction='ignore')
        writer.writeheader()
        writer.writerows(rows)
    temp.replace(path)

def fingerprint(path):
    h = hashlib.sha256()
    with open(path, 'rb') as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b''):
            h.update(block)
    return {'path': str(Path(path).resolve()), 'bytes': Path(path).stat().st_size, 'sha256': h.hexdigest()}

def merge_intervals(intervals):
    merged = []
    for start, end in sorted(intervals):
        if start < 1 or end < start:
            raise ValueError(f'Invalid interval: {start}, {end}')
        if merged and start <= merged[-1][1] + 1:
            merged[-1] = (merged[-1][0], max(end, merged[-1][1]))
        else:
            merged.append((start, end))
    return merged

def complement(length, intervals, minimum=1):
    result, cursor = [], 1
    for start, end in merge_intervals(intervals):
        if end > length:
            raise ValueError(f'Interval ends beyond sequence length {length}')
        if start - cursor >= minimum:
            result.append((cursor, start - 1))
        cursor = end + 1
    if length - cursor + 1 >= minimum:
        result.append((cursor, length))
    return result

def parse_ips(path):
    hits = []
    with open(path) as handle:
        for number, line in enumerate(handle, 1):
            if not line.strip() or line.startswith('#'):
                continue
            p = line.rstrip('\r\n').split('\t')
            try:
                if len(p) < 8:
                    raise ValueError('fewer than 8 columns')
                hits.append(dict(protein_id=p[0], start=int(p[6]), end=int(p[7]),
                                 sequence_length=int(p[2]), analysis=p[3], signature=p[4],
                                 description=p[5], interpro=p[11] if len(p)>11 else '',
                                 line_number=number, raw=line.rstrip('\r\n')))
            except (ValueError, IndexError) as exc:
                raise ValueError(f'{path}:{number}: invalid InterProScan TSV row: {exc}') from exc
    return hits

def parse_hmm(path, coordinates='alignment', ievalue_max=None):
    if coordinates not in ('alignment', 'envelope'):
        raise ValueError('HMM_COORDINATES must be alignment or envelope')
    if ievalue_max is not None and (not math.isfinite(ievalue_max) or ievalue_max < 0):
        raise ValueError('Invalid HMM_IEVALUE_MAX')
    hits = []
    with open(path) as handle:
        for number, line in enumerate(handle, 1):
            if line.startswith('#'):
                if 'program:' in line.lower() and 'hmmscan' in line.lower():
                    raise ValueError('Expected hmmsearch domtblout, received hmmscan orientation')
                continue
            if not line.strip():
                continue
            p = line.split(maxsplit=22)
            try:
                if len(p) < 22:
                    raise ValueError('fewer than 22 fixed columns')
                value = float(p[12])
                if not math.isfinite(value) or value < 0:
                    raise ValueError('invalid independent domain E-value')
                i = 17 if coordinates == 'alignment' else 19
                hits.append(dict(protein_id=p[0], hmm=p[3], sequence_length=int(p[2]),
                                 start=int(p[i]), end=int(p[i+1]), ievalue=value,
                                 accepted=ievalue_max is None or value <= ievalue_max,
                                 line_number=number))
            except (ValueError, IndexError) as exc:
                raise ValueError(f'{path}:{number}: invalid hmmsearch domtblout: {exc}') from exc
    return hits

def validate_hits(hits, sequences, strict=True):
    unmatched = sorted({h['protein_id'] for h in hits} - sequences.keys())
    if unmatched and strict:
        raise ValueError(f'{len(unmatched)} annotation IDs absent from FASTA; examples: {unmatched[:10]}')
    matched = []
    for hit in hits:
        if hit['protein_id'] not in sequences:
            continue
        length = len(sequences[hit['protein_id']])
        if hit['sequence_length'] != length or not 1 <= hit['start'] <= hit['end'] <= length:
            raise ValueError(f'Length/coordinate mismatch: {hit}')
        matched.append(hit)
    return matched, unmatched

def masks_from(hits):
    masks = defaultdict(list)
    for hit in hits:
        masks[hit['protein_id']].append((hit['start'], hit['end']))
    return {name: merge_intervals(intervals) for name, intervals in masks.items()}

def extract_fragments(sequences, masks, label, minimum):
    records, rows = {}, []
    for protein_id, seq in sequences.items():
        for start, end in complement(len(seq), masks.get(protein_id, []), minimum):
            name = f'{protein_id}_{label}_{start}_{end}'
            records[name] = seq[start-1:end]
            rows.append(dict(candidate_id=name, protein_id=protein_id, start=start, end=end, length=end-start+1))
    return records, rows

def accessory_classification(ips, hmms):
    by_id = defaultdict(list)
    for hit in hmms:
        by_id[hit['protein_id']].append(hit)
    audit, kept = [], []
    for hit in ips:
        matches = [h for h in by_id[hit['protein_id']]
                   if hit['start'] <= h['end'] and hit['end'] >= h['start']]
        audit.append({k:v for k,v in hit.items() if k != 'raw'} | {
            'category': 'overlaps_HMMER' if matches else 'accessory_candidate',
            'overlap_hmms': ';'.join(sorted({h['hmm'] for h in matches}))})
        if not matches:
            kept.append(hit['raw'])
    return audit, kept

