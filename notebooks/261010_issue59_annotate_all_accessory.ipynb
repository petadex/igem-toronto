           'interpro_accession':hit['interpro'], 'start':hit['start'], 'end':hit['end'],
           'length':hit['end']-hit['start']+1, 'domain_ievalue':'', 'category':audit['category'],
           'overlapping_hmms':audit['overlap_hmms'], 'source_line':hit['line_number']}
    catalogue.append(row)
for i,hit in enumerate(hmm_hits,1):
    catalogue.append({'hit_id':f'HMM_{i:08d}', 'protein_id':hit['protein_id'], 'source':'HMMER',
                      'analysis':'hmmsearch', 'signature':hit['hmm'], 'description':'', 'interpro_accession':'',
                      'start':hit['start'],'end':hit['end'],'length':hit['end']-hit['start']+1,
                      'domain_ievalue':hit['ievalue'],'category':'HMM_hit','overlapping_hmms':'',
                      'source_line':hit['line_number']})
columns = ['hit_id','protein_id','source','analysis','signature','description','interpro_accession',
           'start','end','length','domain_ievalue','category','overlapping_hmms','source_line']
write_table(run_path/'all_domain_hits.tsv',catalogue,columns)
accessory_rows = [row for row in catalogue if row['source']=='InterProScan' and row['category']=='accessory_candidate']
write_table(run_path/'accessory_domains.tsv',accessory_rows,columns)
print('Accessory candidates with no HMMER overlap:',len(accessory_rows))
for row in catalogue:
    hit_sequences[row['hit_id']] = sequences[row['protein_id']][row['start']-1:row['end']]
write_fasta(run_path/'all_domain_hit_sequences.fa',hit_sequences)
atomic_text(run_path/'interproscan_all_hits.tsv',''.join(h['raw']+'\n' for h in ips_hits))
# Export only selected-protein HMM rows, preserving the original fields.
with open(HMM_DOMTBLOUT) as handle:
    selected_hmm_lines = [line for line in handle if line.startswith('#') or (line.strip() and line.split()[0] in sequences)]
atomic_text(run_path/'hmmer_all_hits.domtblout',''.join(selected_hmm_lines))
print('All reported hits retained:',len(catalogue))
try:
