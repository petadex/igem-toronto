    for cmd in upload_commands:execute_transfer(cmd)
    # Transfer the finalized log once more after the recursive scripts upload.
    cmd=aws_cp(SCRIPTS_DIR/'s3_access_log.jsonl',S3_PREFIX+'scripts/s3_access_log.jsonl')
    print('Final access-log upload:',shlex.join(cmd))
    execute_transfer(cmd)
else:
    print('No upload executed. Access date remains unset until a transfer runs.')

## Environment setup — run once, then switch kernels

Run this cell with `SETUP_ENV=True`, select **Kernel → Change Kernel → igem-toronto**, then reset the flag to `False`
and rerun the notebook from the top. A local `.venv` is created in the repository root and the kernel is registered for
the current user. Python 3.10+ and its `venv` support are required. Requirements are listed in `requirements.txt`;
per-run `environment_freeze.txt` records the installed versions for reproducibility.

This cell is independent of the analysis cells above and can be executed first.

from pathlib import Path
import subprocess,sys,os

SETUP_ENV = False  # Set True for the one-time setup, then return to False
SETUP_PROJECT_ROOT = Path.cwd().resolve()
if SETUP_PROJECT_ROOT.name=='notebooks':
    SETUP_PROJECT_ROOT=SETUP_PROJECT_ROOT.parent
# If necessary, set SETUP_PROJECT_ROOT explicitly to your repository root.
if SETUP_ENV:
    if sys.version_info < (3,10):
        raise RuntimeError('Python 3.10 or newer is required')
    requirements=SETUP_PROJECT_ROOT/'requirements.txt'
    if not requirements.is_file():raise FileNotFoundError(requirements)
    venv=SETUP_PROJECT_ROOT/'.venv'
    python=venv/('Scripts/python.exe' if os.name=='nt' else 'bin/python')
    if not python.is_file():
        subprocess.run([sys.executable,'-m','venv',str(venv)],check=True)
    subprocess.run([str(python),'-m','pip','install','-r',str(requirements)],check=True)
    subprocess.run([str(python),'-m','ipykernel','install','--user','--name','igem-toronto',
                    '--display-name','igem-toronto'],check=True)
    print('Switch to the igem-toronto kernel, set SETUP_ENV=False, then rerun from the top.')
else:
    print('Setup not run. Set SETUP_ENV=True for first-time installation.')
