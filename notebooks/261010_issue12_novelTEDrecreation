ut_c.weight\',\'linout_c.bias\',\'linout_ca.weight\',\'linout_ca.bias\',\'linout_cat.weight\',\'linout_cat.bias\'}\n        need(not incompatible.missing_keys and set(incompatible.unexpected_keys)<=allowed,\'Unexpected embedding checkpoint layout\')\n    def embed(self,text):\n        import numpy as np\n        coords=[[float(l[30:38]),float(l[38:46]),float(l[46:54])] for l in text.splitlines() if l.startswith(\'ATOM\') and l[12:16]==\' CA \']\n        need(5<=len(coords)<=2000,\'FoldClass supports 5..2000 residues; no truncation\')\n        x=self.torch.tensor(np.asarray(coords,dtype=np.float32),device=self.device)[None]\n        with self.torch.no_grad():v=self.net(x).detach().cpu().numpy().reshape(-1)\n        need(v.shape==(128,) and np.isfinite(v).all() and np.linalg.norm(v)>0,\'Invalid embedding\')\n        return v\n\ndef embeddings(run,catalog,label,embedder):\n    import numpy as np\n    source=sqlite3.connect(catalog);dest=Path(catalog).parent/\'embeddings.sqlite\'\n    stamp=dest.with_suffix(\'.identity.json\')\n    folder=Path(run.cfg[\'ted_repo\'])/\'foldclass/embed\'\n    identity=signature(dict(model={p.name:sha(p) for p in folder.iterdir() if p.suffix in (\'.py\',\'.pt\')},catalog=sha(catalog)))\n    if stamp.exists():need(load(stamp)[\'identity\']==identity,\'Embedding model changed; use a new cache_dir\')\n    else:save(stamp,dict(identity=identity))\n    conn=sqlite3.connect(dest)\n    conn.execute(\'CREATE TABLE IF NOT EXISTS vectors (key INTEGER PRIMARY KEY, vector BLOB, reason TEXT)\')\n    existing={r[0] for r in conn.execute(\'SELECT key FROM vectors\')}\n    total=source.execute(\'SELECT count(*) FROM refs\').fetchone()[0]\n    for key,n,text in source.execute(\'SELECT key,n,pdb FROM refs ORDER BY key\'):\n        if key in existing:continue\n        if not 5<=n<=2000:conn.execute(\'INSERT INTO vectors VALUES (?,NULL,?)\',(key,\'outside_5_2000\'))\n        else:conn.execute(\'INSERT INTO vectors VALUES (?,?,NULL)\',(key,embedder.embed(text).astype(\'<f4\').tobytes()))\n        if (len(existing)+1)%100==0:conn.commit();print(label,\'embeddings:\',len(existing)+1,\'/\',total,flush=True)\n        existing.add(key)\n    conn.commit()\n    keys=[];values=[]\n    for k,b in conn.execute(\'SELECT key,vector FROM vectors WHERE vector IS NOT NULL ORDER BY key\'):\n        keys.append(k);values.append(np.frombuffer(b,dtype=\'<f4\').copy())\n    excluded=conn.execute(\'SELECT count(*) FROM vectors WHERE reason IS NOT NULL\').fetchone()[0]\n    conn.close();source.close();need(values,\'No usable reference embeddings\')\n    return keys,np.stack(values),excluded\n\ndef pair(run,q,ref,w,name):\n    target=w/(name+\'.pdb\');target.write_text(ref[\'pdb\'])\n    try:\n        out=run.cmd(w,name,run.cfg[\'tmalign\'],q[\'path\'],target)\n        return parse_tm(out,len(q[\'sequence\']),ref[\'n\'])\n    finally:target.unlink(missing_ok=True)\n\ndef classify(run,records):\n    cfg=run.cfg;rows=run.search(\'04_cath_search\',records,cfg[\'cath_db\'],\'classify\')\n    labels={i:dict(assigned=False,hits=[]) for i in records}\n    catalog_rows=load(cfg[\'cath_reference_manifest\'])\n    catalog_rows=catalog_rows[\'domains\'] if isinstance(catalog_rows,dict) else catalog_rows\n    cath_labels={r[\'id\']:r for r in catalog_rows}\n    def target_labels(target):\n        key=target.split()[0].removesuffix(\'.pdb\')\n        need(key in cath_labels,\'Missing CATH label for \'+target)\n        r=cath_labels[key];return dict(cath_H=r[\'cath_H\'],cath_T=r[\'cath_T\'])\n    for row in rows:\n        cov=row[\'qcov\'] if cfg[\'classification_coverage\']==\'query\' else min(row[\'qcov\'],row[\'tcov\'])\n        tm=row[cfg[\'classification_tm\']]\n        h=tm>.56 and cov>.367 and row[\'evalue\']<.019\n        t=tm>.42 and cov>.786\n        if h or t:labels[row[\'query\']][\'assigned\']=True;labels[row[\'query\']][\'hits\'].append(dict(row,level=\'H\' if h else \'T\',**target_labels(row[\'target\'])))\n    unresolved={i:r for i,r in records.items() if not labels[i][\'assigned\']}\n    if unresolved:\n        def rescue(w):\n            import numpy as np\n            catalog=reference_catalog(run,cfg[\'cath_db\'],\'cath\');emb=Embedder(cfg)\n            keys,matrix,excluded=embeddings(run,catalog,\'CATH\',emb)\n            need(excluded==0,\'CATH references outside embedding range; rescue incomplete\')\n            norm=matrix/np.linalg.norm(matrix,axis=1)[:,None];conn=sqlite3.connect(catalog);results={}\n            for i,q in unresolved.items():\n                need(5<=len(q[\'sequence\'])<=2000,\'Query outside FoldClass range: \'+i)\n                v=emb.embed(Path(q[\'path\']).read_text());s=norm@(v/np.linalg.norm(v));j=int(s.argmax());key=keys[j]\n                title,n,text=conn.execute(\'SELECT title,n,pdb FROM refs WHERE key=?\',(key,)).fetchone()\n                d=w/i;d.mkdir();r=pair(run,q,dict(pdb=text,n=n),d,\'nearest\')\n                results[i]=dict(r,target=title,target_key=key,cosine=float(s[j]),assigned=r[\'qtmscore\']>.5,**target_labels(title))\n            conn.close();return results\n        rescued=run.stage(\'05_foldclass_rescue\',unresolved,rescue)\n        for i,r in rescued.items():labels[i][\'rescue\']=r;labels[i][\'assigned\']=r[\'assigned\']\n    save(run.root/\'classification.json\',labels);return labels\n\ndef filter_hits(run,name,current,rows,kind):\n    policy=run.cfg[\'coverage_policy\'];hits={i:[] for i in current};ambiguous=[]\n    for row in rows:\n        if kind==\'sensitive\':score=max(row[\'qtmscore\'],row[\'ttmscore\'])>.5 or row[\'rmsd\']<3\n        else:score=row[\'qtmscore\']>.56\n        passed={p:score and row[p+\'_qcov\']>.6 and (kind!=\'domains\' or row[p+\'_tcov\']>.6) for p in (\'paired\',\'span\')}\n        if passed[\'paired\']!=passed[\'span\']:ambiguous.append(row)\n        if passed[policy]:hits[row[\'query\']].append(row)\n    save(run.root/(name+\'_decisions.json\'),dict(policy=policy,hits=hits,coverage_dependent_hits=ambiguous))\n    return {i:r for i,r in current.items() if not hits[i]}\n\ndef direct_final(run,current):\n    if run.cfg.get(\'final_search_policy\')==\'released_recipe_fast\':\n        from ted_recipe import direct_final as released\n        return released(run,current)\n    need(run.cfg.get(\'final_search_policy\')==\'legacy_default_tmalign\',\'Resolve final search policy\')\n    return direct_final_default(run,current)\n\n\ndef direct_final_default(run,current):\n    if not current:return current\n    cfg=run.cfg;catalog=reference_catalog(run,cfg[\'domain_db\'],\'domains\')\n    folder=run.root/\'16_direct_tmalign\';folder.mkdir(exist_ok=True)\n    # SQLite retains every successful pair across interruption. No top-hit shortcut.\n    conn=sqlite3.connect(folder/\'pairs.sqlite\')\n    conn.execute(\'CREATE TABLE IF NOT EXISTS pairs (query TEXT, target INTEGER, result TEXT, PRIMARY KEY(query,target))\')\n    src=sqlite3.connect(catalog);nrefs=src.execute(\'SELECT count(*) FROM refs\').fetchone()[0]\n    for ident,q in current.items():\n        done={r[0] for r in conn.execute(\'SELECT target FROM pairs WHERE query=?\',(ident,))}\n        def compare(item):\n            key,n,text=item\n            w=Path(tempfile.mkdtemp(prefix=\'pair_\',dir=folder));target=w/\'reference.pdb\';target.write_text(text)\n            argv=[cfg[\'tmalign\'],q[\'path\'],str(target)]\n            save(w/\'command.json\',argv)\n            result=subprocess.run(argv,capture_output=True,text=True,timeout=cfg.get(\'pair_timeout_seconds\',300))\n            (w/\'stdout.txt\').write_text(result.stdout);(w/\'stderr.txt\').write_text(result.stderr)\n            need(result.returncode==0,f\'Direct TM-align failed: {w}\')\n            parsed=parse_tm(result.stdout,len(q[\'sequence\']),n)\n            return key,parsed,w\n        pending=(r for r in src.execute(\'SELECT key,n,pdb FROM refs ORDER BY key\') if r[0] not in done)\n        # Bounded chunks avoid submitting hundreds of thousands of futures at once.\n        import itertools\n        with concurrent.futures.ThreadPoolExecutor(max_workers=cfg[\'direct_workers\']) as pool:\n            while True:\n                chunk=list(itertools.islice(pending,64))\n                if not chunk:break\n                for key,result,w in pool.map(compare,chunk):\n                    conn.execute(\'INSERT INTO pairs VALUES (?,?,?)\',(ident,key,json.dumps(result)))\n                    conn.commit();done.add(key)\n                    if not tm_match(result):shutil.rmtree(w)\n                print(\'Direct TM-align\',ident,len(done),\'/\',nrefs,flush=True)\n        need(len(done)==nrefs,\'Incomplete direct comparison coverage\')\n    retained={};decisions={}\n    for i,q in current.items():\n        hits=[]\n        for key,text in conn.execute(\'SELECT target,result FROM pairs WHERE query=?\',(i,)):\n            r=json.loads(text)\n            if tm_match(r):hits.append(dict(target_key=key,**r))\n        decisions[i]=dict(comparisons=nrefs,hits=hits)\n        if not hits:retained[i]=q\n    save(folder/\'decisions.json\',decisions);conn.close();src.close();return retained\n\ndef bootstrap_inputs(cfg):\n    from ted_segmentation_adapter import inspect_structure\n    folder=Path(cfg[\'input_dir\']);need(folder.is_dir(),\'Set input_dir to your full-chain PDB folder\')\n    files=sorted(p for p in folder.rglob(\'*.pdb\') if p.is_file())\n    if cfg[\'limit\'] is not None:\n        need(len(files)>=cfg[\'limit\'],f\'Need {cfg["limit"]} input files; found {len(files)}\');files=files[:cfg[\'limit\']]\n    need(files,\'No PDB inputs\');records=[];errors=[]\n    for i,p in enumerate(files):\n        ident=f\'P{i:06d}\'\n        try:\n            residues,sequence,plddt=inspect_structure(p)\n            records.append(dict(id=ident,source_id=p.stem,path=str(p.resolve()),sha256=sha(p),sequence=sequence,plddt=plddt))\n        except Exception as exc:errors.append(dict(id=ident,path=str(p),error=str(exc)))\n    return records,errors,[dict(path=str(p.resolve()),sha256=sha(p)) for p in files]\n\ndef configuration_issues(cfg):\n    issues=[]\n    choices={\'coverage_policy\':(\'paired\',\'span\'),\n        \'classification_tm\':(\'qtmscore\',\'alntmscore\'),\n        \'classification_coverage\':(\'query\',\'minimum\'),\n        \'symd_score\':(\'Z(TsC)\',\'Z(Ts)\',\'Z(TM)\'),\n        \'packing_policy\':(\'released_table\',\'paper_strict\'),\n        \'plddt80_rounding\':(\'ceil\',\'floor\'),\n        \'numbering_policy\':(\'released_TED_offset1\',\'corrected_1based_pending_TED_validation\'),\n        \'final_search_policy\':(\'released_recipe_fast\',\'legacy_default_tmalign\'),\n        \'confidence_policy\':(\'verified_plddt\',\'provisional_plddt\')}\n    for k,values in choices.items():\n        if cfg.get(k) not in values:issues.append(k+\': choose \'+\', \'.join(values))\n    for k in (\'input_dir\',\'foldseek\',\'mmseqs\',\'symd\',\'tmalign\',\'stride\',\'ted_repo\',\n              \'segmentation_root\',\'cath_source_zip\',\'cath_db\',\'pdb_db\',\'domain_db\',\n              \'cath_reference_manifest\'):\n        if not cfg.get(k):issues.append(k+\': path is blank\')\n    if cfg.get(\'final_search_policy\')==\'released_recipe_fast\' and not cfg.get(\'final_recipe_dir\'):\n        issues.append(\'final_recipe_dir: completed official embedding run is required\')\n    if not cfg.get(\'gpu_ids\') or len(set(cfg[\'gpu_ids\']))!=len(cfg[\'gpu_ids\']):\n        issues.append(\'gpu_ids: specify distinct GPU indices, e.g. [0,1,2,3]\')\n    if not cfg.get(\'reference_limitations\'):\n        issues.append(\'reference_limitations: describe chosen database releases / substitutions\')\n    return issues\n\n\ndef preflight(cfg):\n    missing=configuration_issues(cfg)\n    need(not missing,\'Configuration incomplete:\\n- \'+\'\\n- \'.join(missing))\n    need(cfg[\'confidence_policy\'] in (\'verified_plddt\',\'provisional_plddt\'),\'Set confidence policy\')\n    for key in (\'foldseek\',\'mmseqs\',\'symd\',\'tmalign\',\