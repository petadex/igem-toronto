\')\n    paths=[exe,db]+[Path(str(db)+s) for s in (\'.h3f\',\'.h3i\',\'.h3m\',\'.h3p\')]\n    if not all(p.is_file() and p.stat().st_size for p in paths):raise ValueError(\'Incomplete PETadex index\')\n    expected=cfg.get(\'petadex_hmm_sha256\')\n    if expected and digest(db)!=expected:raise ValueError(\'PETadex database checksum differs from saved setup\')\n    policy=cfg.get(\'petadex_acceptance\')\n    if policy is not None:\n        required={\'max_sequence_evalue\',\'max_independent_evalue\',\'min_query_span_coverage\',\'min_hmm_span_coverage\',\'reason\'}\n        if set(policy)!=required or not policy[\'reason\'].strip():raise ValueError(\'Specify all PETadex acceptance fields and reason\')\n        for k in required-{\'reason\'}:\n            v=float(policy[k])\n            if not math.isfinite(v) or v<0 or (\'coverage\' in k and v>1):raise ValueError(\'Invalid PETadex cutoff \'+k)\n        if max(policy[\'max_sequence_evalue\'],policy[\'max_independent_evalue\'])>10:raise ValueError(\'Acceptance E-values exceed reporting limit 10\')\n    return paths\n\ndef assess(row,policy):\n    if policy is None:return \'reported_unassessed\'\n    if row[\'sequence_evalue\']>policy[\'max_sequence_evalue\'] or row[\'independent_domain_evalue\']>policy[\'max_independent_evalue\']:\n        return \'below_acceptance\'\n    if row[\'query_span_coverage\']<policy[\'min_query_span_coverage\'] or row[\'hmm_span_coverage\']<policy[\'min_hmm_span_coverage\']:\n        return \'partial_match_review\'\n    return \'accepted_under_configured_policy\'\n\ndef parse_hits(path,domains,policy):\n    rows=[]\n    for line in Path(path).read_text().splitlines():\n        if not line.strip() or line.startswith(\'#\'):continue\n        f=line.split(maxsplit=22)\n        if len(f)<22 or f[3] not in domains:raise ValueError(\'Malformed or unknown hmmscan query\')\n        d=domains[f[3]];qlen=int(f[5]);hlen=int(f[2]);hs,he,qs,qe=map(int,f[15:19])\n        if qlen!=len(d[\'sequence\']) or not (1<=qs<=qe<=qlen and 1<=hs<=he<=hlen):raise ValueError(\'HMM alignment length/coordinate mismatch\')\n        row=dict(domain_id=f[3],hmm_name=f[0],hmm_accession=f[1],hmm_length=hlen,query_length=qlen,\n                 sequence_evalue=float(f[6]),independent_domain_evalue=float(f[12]),conditional_domain_evalue=float(f[11]),\n                 domain_bitscore=float(f[13]),hmm_start=hs,hmm_end=he,query_start=qs,query_end=qe,\n                 hmm_span_coverage=(he-hs+1)/hlen,query_span_coverage=(qe-qs+1)/qlen)\n        if any(not math.isfinite(row[k]) for k in (\'sequence_evalue\',\'independent_domain_evalue\',\'conditional_domain_evalue\',\'domain_bitscore\')):raise ValueError(\'Nonfinite HMM result\')\n        positions=d.get(\'positions\')\n        if positions is not None and len(positions)!=qlen:raise ValueError(\'Parent position map does not match domain sequence\')\n        row[\'parent_positions_json\']=json.dumps(positions[qs-1:qe]) if positions is not None else \'\'\n        row[\'assessment\']=assess(row,policy);rows.append(row)\n    return rows\n\ndef summarize(domains,rows):\n    summary={}\n    for i in domains:\n        hits=sorted((r for r in rows if r[\'domain_id\']==i),key=lambda r:(r[\'independent_domain_evalue\'],-r[\'domain_bitscore\'],r[\'hmm_name\']))\n        states={r[\'assessment\'] for r in hits}\n        state=next((s for s in (\'accepted_under_configured_policy\',\'partial_match_review\',\'reported_unassessed\',\'below_acceptance\') if s in states),\'no_reported_hit\')\n        summary[i]=dict(assessment=state,reported_hit_rows=len(hits),models=sorted({r[\'hmm_name\'] for r in hits}),best_hit=hits[0] if hits else None)\n    return summary\n\ndef annotate(run,domains):\n    cfg=run.cfg;policy=cfg.get(\'petadex_acceptance\');paths=validate(cfg)\n    key=dict(domains=domains,assets={str(p):digest(p) for p in paths},policy=policy,reporting_evalue=10)\n    def build(w):\n        fasta=w/\'domains.fasta\'\n        with fasta.open(\'w\') as f:\