n        start=time.perf_counter();row=dict(session=self.session,event_id=uuid.uuid4().hex,kind=kind,stage=stage,\n            started_utc=utc(),pid=os.getpid(),thread=threading.get_ident(),status=\'RUNNING\')\n        self.event(row)\n        try:yield\n        except BaseException as exc:\n            row.update(status=\'FAILED\',error_type=type(exc).__name__);raise\n        else:row[\'status\']=\'REUSED\' if reused else \'COMPLETED\'\n        finally:\n            row.update(ended_utc=utc(),elapsed_seconds=round(time.perf_counter()-start,6))\n            with self.lock:\n                self.event(row);self.rows.append(row);self.export()\n    def export(self):\n        columns=[\'session\',\'kind\',\'stage\',\'status\',\'started_utc\',\'ended_utc\',\'elapsed_seconds\',\'pid\',\'thread\',\'error_type\']\n        def write(name,cols,rows):\n            p=self.folder/name;tmp=p.with_suffix(\'.tmp\')\n            with tmp.open(\'w\',newline=\'\') as f:\n                w=csv.DictWriter(f,fieldnames=cols,delimiter=\'\\t\',extrasaction=\'ignore\');w.writeheader();w.writerows(rows)\n            tmp.replace(p)\n        write(\'step_timings.tsv\',columns,self.rows)\n        groups=defaultdict(list)\n        for r in self.rows:groups[(r[\'kind\'],r[\'stage\'].split(\'/\')[0],r[\'status\'])].append(r)\n        summary=[]\n        for (kind,stage,status),rs in sorted(groups.items()):\n            summary.append(dict(kind=kind,stage=stage,status=status,calls=len(rs),\n                summed_task_seconds=round(sum(r[\'elapsed_seconds\'] for r in rs),6),\n                max_task_seconds=max(r[\'elapsed_seconds\'] for r in rs)))\n        write(\'stage_timing_summary.tsv\',[\'kind\',\'stage\',\'status\',\'calls\',\'summed_task_seconds\',\'max_task_seconds\'],summary)\n        p=self.root/\'timing_latest.json\';tmp=p.with_name(\'timing_latest.\'+self.session+\'.tmp\')\n        tmp.write_text(json.dumps(dict(session=self.session,folder=str(self.folder),\n            note=\'Wall-cl