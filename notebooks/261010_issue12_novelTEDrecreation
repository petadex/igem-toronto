equence positions before inference.\n    regression = """import sys\nsys.path.insert(0, \'scripts\')\nfrom domain_consensus import calculate_domain_consensus\nfor s, expected in CASES:\n    _, ranges, counts = calculate_domain_consensus([s]*3, 100, consensus_levels=[3,2,1])\n    assert ranges[0] == expected and tuple(counts) == (1,0,0), (s, ranges, counts)\n    print(\'PASS\', s)\n"""\n    examples=[\'10-50\',\'1-100\',\'1-20_80-100\']\n    expected=[\'11-51\',\'2-100\',\'2-21_81-100\'] if offset else examples\n    regression=regression.replace(\'CASES\',repr(list(zip(examples,expected))))\n    execute([python, \'-c\', regression], \'numbering_regression\')\n    chains, parent_residues, mapping = {}, {}, {}\n    records = payload[\'chains\']\n    check(records and len({r[\'id\'] for r in records}) == len(records), \'Empty/duplicate input manifest\')\n    for i, record in enumerate(records):\n        check(sha(record[\'path\']) == record[\'sha256\'], \'Input checksum mismatch\')\n        residues, sequence, confidence = inspect_structure(record[\'path\'])\n        check(sequence == record[\'sequence\'] and len(confidence) == len(record[\'plddt\']), \'Input sequence mismatch\')\n        check(all(abs(a-b) <= .02 for a,b in zip(confidence, record[\'plddt\'])), \'Input pLDDT mismatch\')\n        name = f\'chain_{i:06d}\'  # Safe paths regardless of external IDs.\n        chains[name] = record\n        parent_residues[name] = residues\n        mapping[name] = dict(parent_id=record[\'id\'], source=str(record[\'path\']), sha256=record[\'sha256\'])\n        write_structure(residues, range(1, len(residues)+1), inputs/(name+\'.pdb\'))\n    (work/\'input_mapping.json\').write_text(json.dumps(mapping, indent=2))\n\n    predictions = {}\n    for method in (\'merizo\', \'unidoc\', \'chainsaw\'):\n        # UniDoc\'s archived wrapper crashes on NULL Merizo output. Do not\n        # silently substitute an independent UniDoc run or invent consensus.\n        if method == \'unidoc\':